+# ============================================================
+# Platform-owned unit identity
+# ============================================================
+
+#: Variables the platform injects into every application process.
+#:
+#: A component descriptor's environment binding carries one value shared by
+#: every replica, so it cannot express a per-replica value. These variables are
+#: therefore supplied by the platform, from the plan it already resolved.
+UNIT_IDENTITY_VARIABLES = (
+    "UNIT_ID",
+    "UNIT_NAME",
+    "UNIT_REPLICA_ID",
+)
+
+
+def unit_identity_environment(unit_plan) -> dict[str, str]:
+    """Build the identity bindings for one unit's application process.
+
+    ``UNIT_REPLICA_ID`` is the resolved 0-based replica index. It is the only
+    stable way for a replica to learn which shard of the workload it owns: a
+    replica that guesses can silently duplicate another replica's work while
+    the run still reports success.
+
+    A descriptor that defines one of these names is rejected rather than
+    silently overridden, because two replicas claiming the same identity is
+    exactly the failure this exists to prevent.
+    """
+
+    conflicts = sorted(
+        binding.name
+        for binding in unit_plan.environment
+        if binding.name in UNIT_IDENTITY_VARIABLES
+    )
+
+    if conflicts:
+        raise ValueError(
+            "Component descriptor defines platform-owned unit identity "
+            f"variable(s): {', '.join(conflicts)}. The platform supplies "
+            f"{', '.join(UNIT_IDENTITY_VARIABLES)} for every unit from the "
+            "resolved plan, because a descriptor binding is shared by all "
+            "replicas and cannot carry a per-replica value."
+        )
+
+    return {
+        "UNIT_ID": unit_plan.id,
+        "UNIT_NAME": unit_plan.unit_name,
+        "UNIT_REPLICA_ID": str(unit_plan.replica),
+    }
+
+
