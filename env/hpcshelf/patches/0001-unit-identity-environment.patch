diff --git a/tests/test_application_manager.py b/tests/test_application_manager.py
index f47933d..f017421 100644
--- a/tests/test_application_manager.py
+++ b/tests/test_application_manager.py
@@ -1,12 +1,88 @@
 import sys
 
 import common_pb2
+import pytest
 
 from unitagent.application_manager import (
+    UNIT_IDENTITY_VARIABLES,
     SubprocessApplicationManager,
+    unit_identity_environment,
 )
 
 
+def make_unit_plan(bindings=()):
+    plan = common_pb2.UnitPlan(
+        id="app-unitagent-test/root/federation/hospital[1]",
+        component_path="root/federation",
+        component_ref="flower-federation:0.1",
+        unit_name="hospital",
+        replica=1,
+        host_id="host-a",
+    )
+
+    for name, value in bindings:
+        plan.environment.add(
+            name=name,
+            value=value,
+        )
+
+    return plan
+
+
+def test_unit_identity_environment_exposes_the_replica_index():
+    """A unit must be able to learn which replica it is, from the plan alone.
+
+    Without this, a workload has no per-replica value to read: an environment
+    binding carries one value shared by every replica, so the index cannot come
+    from the component descriptor.
+    """
+
+    environment = unit_identity_environment(
+        make_unit_plan()
+    )
+
+    assert environment["UNIT_REPLICA_ID"] == "1"
+    assert environment["UNIT_NAME"] == "hospital"
+    assert (
+        environment["UNIT_ID"]
+        == "app-unitagent-test/root/federation/hospital[1]"
+    )
+
+
+def test_unit_identity_variables_are_reported_as_platform_owned():
+    assert unit_identity_environment(
+        make_unit_plan()
+    ).keys() == set(UNIT_IDENTITY_VARIABLES)
+
+
+def test_descriptor_may_not_define_a_unit_identity_variable():
+    """A descriptor binding could otherwise make two replicas share an identity.
+
+    Overriding silently would be worse than failing: the workload would read the
+    descriptor's value and every replica would claim the same shard.
+    """
+
+    plan = make_unit_plan(
+        bindings=[("UNIT_REPLICA_ID", "0")]
+    )
+
+    with pytest.raises(ValueError) as error:
+        unit_identity_environment(plan)
+
+    assert "UNIT_REPLICA_ID" in str(error.value)
+
+
+def test_descriptor_bindings_are_kept_alongside_the_identity():
+    plan = make_unit_plan(
+        bindings=[("SUPERLINK_HOST", "10.201.0.1")]
+    )
+
+    environment = unit_identity_environment(plan)
+
+    assert environment["UNIT_REPLICA_ID"] == "1"
+    assert "SUPERLINK_HOST" not in environment
+
+
